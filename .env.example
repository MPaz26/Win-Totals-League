# Copy to .env and fill in from Supabase: Project Settings -> API.

# Web app (public by design; RLS protects the data)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Standings job (secret: bypasses RLS; never give this to the web app)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
NBA_SEASON=2027

# Weekly recap emails, sent from a Gmail account (Google Account -> Security ->
# 2-Step Verification on, then search "App passwords" and create one)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Win Totals
APP_URL=https://YOUR-USER.github.io/nba-wins-league/
